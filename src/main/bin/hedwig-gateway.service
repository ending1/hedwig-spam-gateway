# systemd 예시 유닛 (Linux 전용). /etc/systemd/system/hedwig-gateway.service 에 배치 후
# systemctl daemon-reload && systemctl enable --now hedwig-gateway
# 프로세스 다운 시 자동 재기동을 위해 Restart=always 사용 (스펙 3.4 워치독 역할).

[Unit]
Description=Hedwig Spam Gateway
After=network.target

[Service]
Type=simple
User=hedwig
WorkingDirectory=/opt/hedwig-gateway
# conf/log4j2.xml이 있으면 재빌드 없이 로그 파일 위치/롤링/레벨을 바꿀 수 있다(Hedwig conf/log4j2.xml과 동일 방식).
ExecStart=/usr/bin/java -Xms256m -Xmx512m -Dlog4j.configurationFile=file:/opt/hedwig-gateway/conf/log4j2.xml -jar /opt/hedwig-gateway/hedwig-spam-gateway.jar --spring.config.location=/opt/hedwig-gateway/conf/application.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
