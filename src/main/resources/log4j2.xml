<?xml version="1.0" encoding="UTF-8"?>
<!-- Hedwig assembly/src/release/conf/log4j2.xml과 동일한 사이즈 기반 롤링 컨벤션(10MB, 10개 보관)을 따른다. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} [%t] %-5p %c{1} - %m%n"/>
        </Console>
        <RollingFile name="GATEWAY_LOG" fileName="../logs/gateway.log" filePattern="../logs/gateway.log.%i">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} [%t] %-5p %c{1} - %m%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10" fileIndex="min"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="com.hs.mail.gateway" level="INFO" additivity="false">
            <AppenderRef ref="GATEWAY_LOG"/>
            <AppenderRef ref="CONSOLE"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="CONSOLE"/>
        </Root>
    </Loggers>
</Configuration>
